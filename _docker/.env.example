# =============================================================================
# PluginHost - local docker environment
# =============================================================================
# Copy this file to `.env` - every value below is a working
# LOCAL default. The passwords are deliberately simple and are intended
# ONLY for local use, never for a deployed environment.
#
# IMAGE_BASE_PATH points at the Gaeco Azure Container Registry - log in with
# `az acr login --name crgaeco001` (or change it to your own registry) before the first start.
# =============================================================================

# =============================================================================
# IMAGE TAGS
# =============================================================================
PLUGINHOST_SERVER_TAG=latest
PLUGINHOST_CLIENT_TAG=latest

# =============================================================================
# GLOBAL SETTINGS
# =============================================================================
IMAGE_BASE_PATH=crgaeco001.azurecr.io

# =============================================================================
# KEYCLOAK (Authentication)
# =============================================================================
KEYCLOAK_SERVER_HOSTNAME=localhost:9345
KEYCLOAK_REALM=gaeco
KEYCLOAK_SERVER_CLIENT_ID=plugin-host-server
KEYCLOAK_SERVER_CLIENT_SECRET=PMDD9BxtquYUohAV33SzcZc1ZijLnKhk
KEYCLOAK_CLIENT_CLIENT_ID=plugin-host-client

# =============================================================================
# PLUGIN HOST SERVER
# =============================================================================
PLUGINHOST_SERVER_HOSTNAME=localhost:5240
PLUGINHOST_SERVER_GETPLUGIN_SECRET=your-very-secure-and-long-key123!
PLUGINHOST_SIGNALR_HUB_PATH=/hub
PLUGINHOST_SIGNALR_PLUGIN_EVENT=PluginChange
PLUGINHOST_SIGNALR_OPERATION_ADD_PLUGIN=Add
PLUGINHOST_SIGNALR_OPERATION_DELETE_PLUGIN=Delete
PLUGINHOST_SIGNALR_OPERATION_PATCH_PLUGINS=Patch

# =============================================================================
# PLUGIN HOST CLIENT
# =============================================================================
PLUGINHOST_CLIENT_HOSTNAME=localhost:5000

# =============================================================================
# PLUGIN HOST POSTGRES
# =============================================================================
PLUGINHOST_POSTGRES_USER=postgres
PLUGINHOST_POSTGRES_PASSWORD=postgres
PLUGINHOST_POSTGRES_DATABASE=pluginhostdb

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# Die folgenden Variablen werden in deployed Umgebungen vom Orchestrator
# injiziert und sind ausschliesslich fuer den lokalen Docker-Compose-Betrieb
# benoetigt.
# =============================================================================
STACK_NAME=pluginhost
ENVIRONMENT_NETWORK=gaeco-local
TRAEFIK_NETWORK=traefik-proxy
VOLUME_BASE_PATH=./volumes

# --- Override (Port-Bindings)
PLUGINHOST_POSTGRES_OUTERPORT=6434
PLUGINHOST_SERVER_OUTERPORT=5240
PLUGINHOST_CLIENT_OUTERPORT=5000
